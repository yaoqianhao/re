// 全景静帧：固定高位相机，把 9 条楼梯 / 斜坡赛道一次拍全，用于验收场景规模与布局。
// 与 keyboard_probe.rhai 共用同一份限值口径（级高 0.35m / 坡角 45 度），这里不跑运动。
fn on_start() {
    set_pos("player", 0.0, 0.9, 9.0);
    camera(0.0, 46.0, 40.0, 0.0, 0.0, -7.0);
    text_add("hud_title", "r3e 楼梯 / 斜坡实验场", 24.0, 18.0, 26.0, 1.0, 0.93, 0.75);
    text_add("hud_sub", "5 条楼梯（级高 0.10 / 0.18 / 0.25 / 0.32 / 0.50 m）+ 4 条斜坡（12 / 25 / 40 / 60 度）", 24.0, 56.0, 16.0, 0.80, 0.88, 0.98);
    text_add("hud_rule", "圆柱角色：直径 0.8m 高 1.8m · 可跨级高 0.35m · 可攀坡角 45 度 · WASD 键盘控制", 24.0, 84.0, 16.0, 0.66, 0.74, 0.86);
    log("panorama 相机已就位");
}

fn on_update(dt) {
    // 静帧：不读输入、不移动角色
    camera(0.0, 46.0, 40.0, 0.0, 0.0, -7.0);
}
